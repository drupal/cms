#!/usr/bin/env bash

## Deploys your site to Railway.
## Usage: deploy:railway
## Example: "ddev deploy:railway"

# Abort if any step fails.
set -euo pipefail

# Confirm that the project is in a good state.
composer validate --strict --no-check-publish --no-check-all --no-check-version

# Export configuration.
DRUPAL_CONFIG_SYNC_DIRECTORY="$PWD/config" composer exec dr -- config:export --yes

# Install the Railway CLI and SDK.
npm install --save-dev @railway/cli railway

# Everything we're about to do requires us to be logged in.
npx railway whoami || npx railway login --browserless

# Define and configure the project's services, if not already done. We ship a
# ready-made template alongside this command and copy it into the project on
# first run. After that the developer owns it, and we never overwrite it.
test -d .railway || cp -R $(dirname "$0")/.railway .

ENV_FILE="$PWD/.ddev/.env"
# DDEV only loads $ENV_FILE when the project starts, so load it ourselves in
# case it has changed since then. `set -a` exports every variable in it, just
# like DDEV does.
if [ -f "$ENV_FILE" ]; then
  set -a
  source "$ENV_FILE"
  set +a
fi

# Initialize a project with an auto-generated name, and grab its ID from the
# JSON output. The `-e` makes jq fail if there's no ID, which stops the script.
if [ -z "${RAILWAY_PROJECT_ID:-}" ]; then
  # Exporting on a separate line keeps a failure from being ignored. On the
  # same line, `set -e` would only see whether `export` worked.
  RAILWAY_PROJECT_ID=$(npx railway init --name="" --json | jq -e -r '.id')
  export RAILWAY_PROJECT_ID
  # Save the project ID for later use.
  echo "RAILWAY_PROJECT_ID=$RAILWAY_PROJECT_ID" >> "$ENV_FILE"

  # Apply the IaC configuration. We only do this once, when initializing the
  # project, because we're setting up the infrastructure. Once that's done, the
  # developer owns it.
  npx railway config apply --yes

  # Generate a public domain, and grab it from the JSON output.
  DOMAIN=$(npx railway domain --service=web --port=8080 --json | jq -e -r '.domain')

  # Ensure Drush generates correct URLs and Drupal trusts Railway hosts.
  npx railway variable set DRUSH_OPTIONS_URI="$DOMAIN" DRUPAL_TRUSTED_HOSTS="${DOMAIN#*://},healthcheck.railway.app" --service=web

  # Create a random hash salt and send it straight to Railway. Using --stdin
  # keeps the secret out of the command line.
  openssl rand -hex 32 | npx railway variable set DRUPAL_HASH_SALT --stdin --service=web

  # This is the initial deployment, so export the content.
  composer exec dr -- content:export:all "$PWD/content"
fi

# Ensure Railway ignores everything Docker does when building the image.
test -f .railwayignore || ln -s .dockerignore .railwayignore

# Bring the project online, but don't wait up. We name the project explicitly,
# rather than trusting the Railway CLI to remember which one this site uses.
#
# Railway refuses to deploy with --project unless we also name an environment.
# Every new Railway project starts with one called "production", so we use it.
# @see https://github.com/railwayapp/cli/blob/master/src/commands/up.rs
#
# `railway up` uploads this directory's code to a single service, so we have to
# name the one that runs Drupal. The database doesn't need this: it runs from
# a ready-made image, and Railway keeps it running once it has been created.
npx railway up --detach --project="${RAILWAY_PROJECT_ID:?The Railway project ID is unknown.}" --environment=production --service=web

# We no longer need the exported content.
rm -r -f content
